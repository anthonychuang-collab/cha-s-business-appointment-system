{
  "name": "clinic-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node --env-file-if-exists=.env.local scripts/db.mjs dev-setup",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:db": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db.mjs migrate",
    "db:seed-dev": "node --env-file-if-exists=.env.local scripts/db.mjs seed-dev",
    "db:reset": "node --env-file-if-exists=.env.local scripts/db.mjs reset",
    "db:create-admin": "node --env-file-if-exists=.env.local scripts/db.mjs create-admin",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh"
  },
  "dependencies": {
    "next": "16.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}

# 複製成 .env.local 後填寫（.env.local 不會進 git）

# PostgreSQL 連線字串（必填）
# - 本機開發：postgres://使用者:密碼@localhost:5432/clinic
# - Supabase：Project Settings → Database → Connection string → 「Transaction pooler」（port 6543），
#   例：postgres://postgres.<project-ref>:<密碼>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require
#   執行 migration（npm run db:migrate）也可用同一條；若遇到逾時可改用「Session pooler」（port 5432）。
DATABASE_URL=

# 連線池上限（Vercel 等 serverless 建議 1–5，預設 5）
# DATABASE_POOL_MAX=5

# 開發用測試帳號密碼（只在非正式環境建立測試帳號時使用；未設定為 dev-only-1234）
DEV_PASSWORD=

# 資料庫整合測試用的資料庫，「每次測試都會被清空」：只接受 localhost 或名稱含 test 的資料庫（npm run test:db）
# TEST_DATABASE_URL=postgres://使用者:密碼@localhost:5432/clinic_test

# 以下為接上正式服務時需要（尚未串接）
# RESEND_API_KEY=          # 寄送通知 email
# NOTIFY_FROM=             # 寄件地址
# CRON_SECRET=             # 每日日報排程驗證金鑰
